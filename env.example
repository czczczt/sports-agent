POSTGRES_PASSWORD=change-me
DB_PORT=5434 # Docker - 5434, win postgres - 5432
DATABASE_URL=postgresql://agent:change-me@127.0.0.1:5434/sports_agent

# Конфигурация
SQLITE_DB_PATH=running.db
APP_HOST=0.0.0.0
APP_PORT=8000

# GigaChat API
GIGACHAT_CREDENTIALS==

# Модели GigaChat:
# - GigaChat       (быстрая базовая модель)
# - GigaChat-Plus  (сбалансированная модель с увеличенным контекстом)
# - GigaChat-Pro   (продвинутая модель для сложного анализа и логики)
# - GigaChat-Max   (флагманская модель с максимальным качеством)
GIGACHAT_MODEL=GigaChat-Plus
