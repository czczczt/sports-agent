# Fill these before starting Compose. Generate independent random values.
POSTGRES_PASSWORD=
AUTH_SECRET_KEY=
POSTGRES_USER=agent
POSTGRES_DB=sports_agent
DB_PORT=5434
# Host tools use loopback and the published DB port. Percent-encode URL passwords.
DATABASE_URL=postgresql://agent:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:5434/sports_agent
# Optional container-only DSN; default points at Compose service db:5432.
# COMPOSE_DATABASE_URL=postgresql://agent:URL_ENCODED_PASSWORD@db:5432/sports_agent
APP_HOST=127.0.0.1
APP_PORT=8000
GIGACHAT_CREDENTIALS=
GIGACHAT_MODEL=GigaChat
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_VERIFY_SSL=true
# A separate local/CI PostgreSQL role with CREATEDB for disposable integration DBs.
# TEST_POSTGRES_ADMIN_URL=postgresql://test_role:URL_ENCODED_PASSWORD@127.0.0.1:5434/postgres
