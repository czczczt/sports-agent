# ==============================================================================
# Sports Agent Environment Configuration (SPEC v1.3 §4.1, §12)
# ==============================================================================

# --- PostgreSQL Database ---
POSTGRES_DB=sports_agent
POSTGRES_USER=agent
POSTGRES_PASSWORD=replace_with_strong_password_in_production
DB_PORT=5434

# Standard connection string for app and migrations
DATABASE_URL=postgresql://agent:replace_with_strong_password_in_production@db:5432/sports_agent

# --- Security & Authentication ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_SECRET_KEY=replace_with_random_secret_key_minimum_32_characters

# Domain name for Caddy automatic TLS / reverse proxy
APP_DOMAIN=localhost
FRONTEND_BASE_URL=https://localhost

# Brute force protection (SPEC v1.3 §12)
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# Privacy & TTL policy (SPEC v1.3 §12: raw data stored up to 90 days)
RAW_TTL_DAYS=90

# Backup retention policy (SPEC v1.3 §12: daily pg_dump, 14 days retention)
BACKUP_RETENTION_DAYS=14

# --- Application Server ---
APP_HOST=0.0.0.0
APP_PORT=8000

# --- GigaChat API (Agent & AI features) ---
GIGACHAT_CREDENTIALS=
GIGACHAT_MODEL=GigaChat
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_VERIFY_SSL=true

# --- Protocol recipe agent ---
RECIPE_AGENT_PROVIDER=gigachat
RECIPE_AGENT_MODEL=
RECIPE_AGENT_BASE_URL=
RECIPE_AGENT_API_KEY=
AUTO_APPLY_SAFE_REPAIRS=true
# RECIPE_RAW_ROOT=parser_running/data/raw

# --- Email Notifications (Password Reset) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@sbersport.local
SMTP_USE_TLS=true
